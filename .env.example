# Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Server topology. These bootstrap the guildConfig document on first run;
# afterwards guildConfig is the source of truth and is edited with /config set.
#
# PUBLIC_GUILD_ID is the Rainbow Isle community server: roles, tracked channels
# and message events all live there.
# STAFF_GUILD_ID is Rainbow Isle: Offices, the staff server: review cards, leave
# approvals, Executive reports and the assessment feed post there.
#
# The bot displays whatever these servers are actually named, fetched at
# startup, so a rename needs no change here.
PUBLIC_GUILD_ID=
STAFF_GUILD_ID=

# MongoDB
MONGO_URL=mongodb://mongo:27017
MONGO_DB=staffbot

# Internal HTTP API (compose network only, never published).
# A value that is not a whole port number stops the bot at startup rather than
# binding an arbitrary free port under a log line saying "listening".
API_PORT=8080
API_BEARER_TOKEN=

# Bootstrap escape hatch. Comma or space separated Discord user IDs that are
# treated as Executive regardless of their roles.
#
# Required for first setup: Executive tier is resolved from the executiveRoles
# config key, which is empty on a fresh install, so without this nobody can run
# the /config set that would populate it. Keep it to the one or two people who
# administer the deployment. Every use is logged.
BOOTSTRAP_ADMIN_IDS=

# Whether /dev purge may delete records that are NOT from a rehearsal.
#
# Leave it unset. A rehearsal's own records were never real and can always be
# cleared, so a dry run stays a one-click cleanup either way. This only unlocks
# deleting somebody's actual assessment history, which should cost a deliberate
# change here and a restart rather than one mistyped fortnight number in a
# slash command. Set it to exactly "true" for as long as you need it, then unset
# it again.
DEV_DANGEROUS_COMMANDS=

# Optional: "debug" | "info" | "warn" | "error". Default "info".
LOG_LEVEL=info
